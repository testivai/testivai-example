{
  "name": "testivai-example",
  "private": true,
  "description": "Example: open-source TestivAI visual regression on a three-page static site, with an MCP server for AI agents",
  "scripts": {
    "serve": "http-server site -p 4173 -c-1",
    "test": "playwright test",
    "report": "testivai report",
    "approve": "testivai approve --all",
    "demo": "node demo/run.mjs",
    "test:demo": "node --test \"demo/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.0",
    "@testivai/mcp": "^0.8.0",
    "@testivai/witness": "^2.2.1",
    "@testivai/witness-playwright": "^2.0.6",
    "http-server": "^14.1.1",
    "yaml": "^2.9.1"
  }
}
